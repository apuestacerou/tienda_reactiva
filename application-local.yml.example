# Copiar a application-local.yml (junto al pom.xml). Ese archivo no va a git.
#
# Neon: r2dbc:postgresql://HOST_POOLER.neon.tech:5432/neondb?sslmode=require
# Redis Cloud: host, puerto, usuario default y contraseña del panel Conectar

spring:
  r2dbc:
    url: r2dbc:postgresql://TU_HOST_POOLER.neon.tech:5432/neondb?sslmode=require
    username: neondb_owner
    password: PEGA_AQUI_TU_CONTRASENA_NEON
  data:
    redis:
      host: TU_HOST.db.redis.io
      port: 11700
      username: default
      password: PEGA_AQUI_TU_PASSWORD_REDIS
